    <parent link="pan_tilt_tilt_motor_base_link"/>
    <child link="pan_tilt_tilt_motor_link"/>
    <origin rpy="0.065 0 3.141592653589793" xyz="0 0 0.0"/>
    <axis xyz="-1 0 0"/>
    <limit effort="1.5" lower="-3.141592653589793" upper="0.3490658503988659" velocity="6.178465545"/>
    <dynamics damping="0.7" friction="0.5"/>
  </joint>
  <!-- <joint name="${name}_joint" type="revolute" >
      <parent link="${name}_base_link" />
      <child link="${name}_link" />
      <origin xyz="0 0 0.0" rpy="${position_offset} 0 ${M_PI}"/>
      <axis xyz="${motor_direction} 0 0"/>
      <limit effort="1.5" lower="-${M_PI / 180 * 110}" upper="${M_PI / 180 * 110}" velocity="6.178465545"/>
    </joint> -->
  <link name="pan_tilt_tilt_motor_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <gazebo reference="pan_tilt_tilt_motor_link">
    <turnGravityOff>false</turnGravityOff>
  </gazebo>
  <transmission name="pan_tilt_tilt_motor_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <actuator name="pan_tilt_tilt_motor_motor">
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
    <joint name="pan_tilt_tilt_motor_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
  </transmission>
  <joint name="pan_tilt_tilt_bracket_joint" type="fixed">
    <origin rpy="1.5057963267948966 0 0" xyz="0 0 0"/>
    <parent link="pan_tilt_tilt_motor_link"/>
    <child link="pan_tilt_tilt_bracket_link"/>
  </joint>
  <link name="pan_tilt_tilt_bracket_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://steve_simulation/robots/mmo_700/meshes/cameras/dynamixel/dynamixel_bracket_fr12_h101.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://steve_simulation/robots/mmo_700/meshes/cameras/dynamixel/dynamixel_bracket_fr12_h101_convex_hull.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="pan_tilt_pan_motor_base_joint" type="fixed">
    <origin rpy="0 1.5707963267948966 0" xyz="0 0.0633 0"/>
    <parent link="pan_tilt_tilt_bracket_link"/>
    <child link="pan_tilt_pan_motor_base_link"/>
  </joint>
  <link name="pan_tilt_pan_motor_base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin rpy="0 1.5707963267948966 0" xyz="0 0 0.0"/>
      <geometry>
        <mesh filename="package://steve_simulation/robots/mmo_700/meshes/cameras/dynamixel/dynamixel_motor_xl-430.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 1.5707963267948966 0" xyz="0 0 0.0"/>
      <geometry>
        <mesh filename="package://steve_simulation/robots/mmo_700/meshes/cameras/dynamixel/dynamixel_motor_xl-430_convex_hull.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="pan_tilt_pan_motor_joint" type="revolute">
    <parent link="pan_tilt_pan_motor_base_link"/>
    <child link="pan_tilt_pan_motor_link"/>
    <origin rpy="0.065 0 3.141592653589793" xyz="0 0 0.0"/>
    <axis xyz="-1 0 0"/>
    <limit effort="1.5" lower="-3.141592653589793" upper="0.3490658503988659" velocity="6.178465545"/>
    <dynamics damping="0.7" friction="0.5"/>
  </joint>
  <!-- <joint name="${name}_joint" type="revolute" >
      <parent link="${name}_base_link" />
      <child link="${name}_link" />
      <origin xyz="0 0 0.0" rpy="${position_offset} 0 ${M_PI}"/>
      <axis xyz="${motor_direction} 0 0"/>
      <limit effort="1.5" lower="-${M_PI / 180 * 110}" upper="${M_PI / 180 * 110}" velocity="6.178465545"/>
    </joint> -->
  <link name="pan_tilt_pan_motor_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <gazebo reference="pan_tilt_pan_motor_link">
    <turnGravityOff>false</turnGravityOff>
  </gazebo>
  <transmission name="pan_tilt_pan_motor_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <actuator name="pan_tilt_pan_motor_motor">
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
    <joint name="pan_tilt_pan_motor_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
  </transmission>
  <joint name="pan_tilt_pan_bracket_joint" type="fixed">
    <origin rpy="3.076592653589793 0 0" xyz="0 0 0"/>
    <parent link="pan_tilt_pan_motor_link"/>
    <child link="pan_tilt_pan_bracket_link"/>
  </joint>
  <link name="pan_tilt_pan_bracket_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://steve_simulation/robots/mmo_700/meshes/cameras/dynamixel/dynamixel_bracket_fr12_h101.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://steve_simulation/robots/mmo_700/meshes/cameras/dynamixel/dynamixel_bracket_fr12_h101_convex_hull.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <ros2_control name="pan_tilt_ros2_control" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      <hold_joints>true</hold_joints>
    </hardware>
    <joint name="pan_tilt_pan_motor_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="pan_tilt_tilt_motor_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">-0.2</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <!-- Camera body -->
  <joint name="pan_tilt_camera_joint" type="fixed">
    <origin rpy="1.5707963267948966 1.5707963267948966 3.141592653589793" xyz="0 0.04 0"/>
    <parent link="pan_tilt_pan_bracket_link"/>
    <child link="pan_tilt_camera_link"/>
  </joint>
  <link name="pan_tilt_camera_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <!-- L515 is cylindrical, approximately 61mm diameter x 26mm depth -->
        <cylinder length="0.026" radius="0.0305"/>
      </geometry>
      <material name="l515_grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.026" radius="0.0305"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <!-- Color optical frame -->
  <joint name="pan_tilt_camera_color_optical_joint" type="fixed">
    <origin rpy="0 -1.57 1.57" xyz="0 0 0.01"/>
    <parent link="pan_tilt_camera_link"/>
    <child link="pan_tilt_camera_color_optical_frame"/>
  </joint>
  <link name="pan_tilt_camera_color_optical_frame"/>
  <joint name="pan_tilt_camera_depth_optical_joint" type="fixed">
    <origin rpy="0 -1.57 1.57" xyz="0 0 0.01"/>
    <parent link="pan_tilt_camera_link"/>
    <child link="pan_tilt_camera_depth_optical_frame"/>
  </joint>
  <link name="pan_tilt_camera_depth_optical_frame"/>
  <gazebo reference="pan_tilt_camera_color_optical_frame">
    <sensor name="pan_tilt_camera" type="depth">
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.2217304763960306</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>9.0</far>
        </clip>
      </camera>
      <plugin filename="libgazebo_ros_camera.so" name="pan_tilt_camera_controller">
        <ros>
          <namespace>pan_tilt_camera</namespace>
          <remapping>image_raw:=color/image_raw</remapping>
          <remapping>camera_info:=color/camera_info</remapping>
          <remapping>depth/image_raw:=aligned_depth_to_color/image_raw</remapping>
          <remapping>depth/camera_info:=aligned_depth_to_color/camera_info</remapping>
          <remapping>points:=depth/color/points</remapping>
        </ros>
        <camera_name>pan_tilt_camera</camera_name>
        <frame_name>pan_tilt_camera_color_optical_frame</frame_name>
        <hack_baseline>0.05</hack_baseline>
        <min_depth>0.1</min_depth>
        <max_depth>9.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="pan_tilt_tower_base">
    <material>Gazebo/Grey</material>
  </gazebo>
  <!-- Dynamixel motor materials -->
  <gazebo reference="pan_tilt_tilt_motor_base_link">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="pan_tilt_pan_motor_base_link">
    <material>Gazebo/Black</material>
  </gazebo>
  <!-- Bracket materials -->
  <gazebo reference="pan_tilt_tilt_bracket_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="pan_tilt_pan_bracket_link">
    <material>Gazebo/Grey</material>
  </gazebo>
</robot>
